<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PhotoRecull.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, so `dotnet run` works; Store builds package it (below). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs provides Main so it can enforce a single running instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    The built-in Google OAuth client. Desktop client secrets can't be kept secret,
    but GitHub's secret scanning blocks committing them, so they come from MSBuild
    properties instead: GoogleOAuthClient.local.props (git-ignored) when building
    locally, or the PhotoRecullGoogleClientId/Secret environment variables in CI.
    Builds without them fall back to a credentials.json chosen in Setup.
  -->
  <Import Project="GoogleOAuthClient.local.props" Condition="Exists('GoogleOAuthClient.local.props')" />
  <ItemGroup Condition="'$(PhotoRecullGoogleClientId)' != '' and '$(PhotoRecullGoogleClientSecret)' != ''">
    <AssemblyMetadata Include="PhotoRecull.GoogleClientId" Value="$(PhotoRecullGoogleClientId)" />
    <AssemblyMetadata Include="PhotoRecull.GoogleClientSecret" Value="$(PhotoRecullGoogleClientSecret)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Microsoft Store package: build with -p:PhotoRecullPackage=true (see docs/STORE.md).
    The Store signs what's uploaded, so the package isn't signed here.
  -->
  <PropertyGroup Condition="'$(PhotoRecullPackage)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <!-- A plain .msix, which Partner Center accepts; the .msixupload wrapper needs Visual Studio's MSBuild. -->
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxPackageDir>$(MSBuildThisFileDirectory)..\..\artifacts\store\</AppxPackageDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(PhotoRecullPackage)' == 'true'">
    <AppxManifest Include="Package.appxmanifest" />
  </ItemGroup>
  <ItemGroup Condition="'$(PhotoRecullPackage)' != 'true'">
    <None Remove="Package.appxmanifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoRecull.Core\PhotoRecull.Core.csproj" />
  </ItemGroup>

</Project>
