<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PhotoRecull.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged for now so `dotnet run` works; MSIX packaging for the Store comes later. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs provides Main so it can enforce a single running instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    The built-in Google OAuth client. Desktop client secrets can't be kept secret,
    but GitHub's secret scanning blocks committing them, so they come from MSBuild
    properties instead: GoogleOAuthClient.local.props (git-ignored) when building
    locally, or the PhotoRecullGoogleClientId/Secret environment variables in CI.
    Builds without them fall back to a credentials.json chosen in Setup.
  -->
  <Import Project="GoogleOAuthClient.local.props" Condition="Exists('GoogleOAuthClient.local.props')" />
  <ItemGroup Condition="'$(PhotoRecullGoogleClientId)' != '' and '$(PhotoRecullGoogleClientSecret)' != ''">
    <AssemblyMetadata Include="PhotoRecull.GoogleClientId" Value="$(PhotoRecullGoogleClientId)" />
    <AssemblyMetadata Include="PhotoRecull.GoogleClientSecret" Value="$(PhotoRecullGoogleClientSecret)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoRecull.Core\PhotoRecull.Core.csproj" />
  </ItemGroup>

</Project>
