<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PhotoRecull.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- x64 by default; -p:Platform=ARM64 builds natively for Windows on Arm. -->
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, so `dotnet run` works; Store builds package it (below). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs provides Main so it can enforce a single running instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    The built-in Google OAuth client. Desktop client secrets can't be kept secret,
    but GitHub's secret scanning blocks committing them, so they come from MSBuild
    properties instead: GoogleOAuthClient.local.props (git-ignored) when building
    locally, or the PhotoRecullGoogleClientId/Secret environment variables in CI.
    Builds without them fall back to a credentials.json chosen in Setup.
  -->
  <Import Project="GoogleOAuthClient.local.props" Condition="Exists('GoogleOAuthClient.local.props')" />
  <ItemGroup Condition="'$(PhotoRecullGoogleClientId)' != '' and '$(PhotoRecullGoogleClientSecret)' != ''">
    <AssemblyMetadata Include="PhotoRecull.GoogleClientId" Value="$(PhotoRecullGoogleClientId)" />
    <AssemblyMetadata Include="PhotoRecull.GoogleClientSecret" Value="$(PhotoRecullGoogleClientSecret)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Microsoft Store package: build with -p:PhotoRecullPackage=true (see docs/STORE.md).
    The Store signs what's uploaded, so the package isn't signed here.
  -->
  <PropertyGroup Condition="'$(PhotoRecullPackage)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!-- The Store build is the paid one: its free trial limits staging and deleting (Services/StoreLicense.cs). -->
    <DefineConstants>$(DefineConstants);PHOTORECULL_STORE</DefineConstants>
    <!-- Customers' PCs needn't have .NET installed: the package carries the runtime too. -->
    <SelfContained>true</SelfContained>
    <!-- The Windows App SDK runtime isn't carried, though: the package depends on its framework
         package, which the Store installs with the app and shares between apps. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <!-- A plain .msix, which Partner Center accepts; the .msixupload wrapper needs Visual Studio's MSBuild. -->
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxPackageDir>$(MSBuildThisFileDirectory)..\..\artifacts\store\</AppxPackageDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(PhotoRecullPackage)' == 'true'">
    <AppxManifest Include="Package.appxmanifest" />
  </ItemGroup>
  <ItemGroup Condition="'$(PhotoRecullPackage)' != 'true'">
    <None Remove="Package.appxmanifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- The Windows App SDK's parts the app uses, not the whole SDK: its AI, ML, Search and
         Widgets parts would add about 40 MB of ONNX Runtime and DirectML to the package. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoRecull.Core\PhotoRecull.Core.csproj" />
  </ItemGroup>

</Project>
