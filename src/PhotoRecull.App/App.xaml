<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PhotoRecull.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CleanupDoneBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="CleanupStagedBrush" Color="#C19C00" />
                    <SolidColorBrush x:Key="CleanupReadyToActBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="CleanupPickedBrush" Color="#6EA6DC" />
                    <SolidColorBrush x:Key="NotCleanedHatchBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="TodayLineBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="HoldToConfirmBackgroundBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="HoldToConfirmBorderBrush" Color="#A52A1B" />
                    <SolidColorBrush x:Key="HoldToConfirmFillBrush" Color="#8F1D12" />
                    <SolidColorBrush x:Key="HoldToConfirmTextBrush" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="PillNotCleanedForeground" Color="#5D5D5D" />
                    <SolidColorBrush x:Key="PillNotCleanedBackground" Color="#0E000000" />
                    <SolidColorBrush x:Key="PillPickedForeground" Color="#003E92" />
                    <SolidColorBrush x:Key="PillPickedBackground" Color="#E5F0FB" />
                    <SolidColorBrush x:Key="PillReadyToActForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PillReadyToActBackground" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="PillStagedForeground" Color="#7A4A00" />
                    <SolidColorBrush x:Key="PillStagedBackground" Color="#FFF4CE" />
                    <SolidColorBrush x:Key="PillDoneForeground" Color="#0E6B0E" />
                    <SolidColorBrush x:Key="PillDoneBackground" Color="#DFF6DD" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CleanupDoneBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="CleanupStagedBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="CleanupReadyToActBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="CleanupPickedBrush" Color="#4A7BAF" />
                    <SolidColorBrush x:Key="NotCleanedHatchBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="TodayLineBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HoldToConfirmBackgroundBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="HoldToConfirmBorderBrush" Color="#E0503F" />
                    <SolidColorBrush x:Key="HoldToConfirmFillBrush" Color="#7A160D" />
                    <SolidColorBrush x:Key="HoldToConfirmTextBrush" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="PillNotCleanedForeground" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="PillNotCleanedBackground" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="PillPickedForeground" Color="#99C3EA" />
                    <SolidColorBrush x:Key="PillPickedBackground" Color="#1F3A5C" />
                    <SolidColorBrush x:Key="PillReadyToActForeground" Color="#000000" />
                    <SolidColorBrush x:Key="PillReadyToActBackground" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="PillStagedForeground" Color="#FCE100" />
                    <SolidColorBrush x:Key="PillStagedBackground" Color="#433519" />
                    <SolidColorBrush x:Key="PillDoneForeground" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="PillDoneBackground" Color="#393D1B" />
                </ResourceDictionary>
                <!-- Contrast themes: states are told apart by their labels, so use the system's contrast colors. -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CleanupDoneBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CleanupStagedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="CleanupReadyToActBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CleanupPickedBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="NotCleanedHatchBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="TodayLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="HoldToConfirmBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="HoldToConfirmBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="HoldToConfirmFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="HoldToConfirmTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

                    <SolidColorBrush x:Key="PillNotCleanedForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PillNotCleanedBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PillPickedForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PillPickedBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PillReadyToActForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PillReadyToActBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PillStagedForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PillStagedBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PillDoneForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PillDoneBackground" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,20,0,16" />
            </Style>

            <Style x:Key="SecondaryCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="SettingRowDividerStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="68,12,20,12" />
            </Style>

            <Thickness x:Key="PageHorizontalPadding">40,0,40,0</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
