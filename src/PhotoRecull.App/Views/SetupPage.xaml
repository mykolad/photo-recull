<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhotoRecull.App.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoRecull.App.Views">

    <ScrollViewer>
        <StackPanel MaxWidth="820" Margin="40,24,40,40" Spacing="16">

            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
                <Image Source="ms-appx:///Assets/AppIcon.48.png" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Set up PhotoRecull" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="Repeat your Google Photos culls on your other copies."
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Source -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid Padding="20,16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE91B;" FontSize="24" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Google Photos" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="PhotoRecull only reads from Google. You pick the photos you kept in Google's Photos Picker."
                                Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE73E;"
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind views:XamlFunctions.ConnectionLabel(ViewModel.IsConnected), Mode=OneWay}"
                                Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Style="{StaticResource SettingRowDividerStyle}"
                        Visibility="{x:Bind ViewModel.NeedsDeveloperCredentialsFile}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="OAuth credentials file (developer build)" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Text="{x:Bind ViewModel.DeveloperCredentialsPath, Mode=OneWay}"
                                    IsReadOnly="True"
                                    PlaceholderText="credentials.json" />
                                <Button Grid.Column="1" Content="Browse…" Command="{x:Bind ViewModel.BrowseDeveloperCredentialsCommand}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Text="credentials.json from your Google Cloud project."
                                    Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                    VerticalAlignment="Center" />
                                <HyperlinkButton
                                    Content="Setup guide"
                                    NavigateUri="https://mykolad.github.io/photo-recull/SETUP"
                                    Padding="2,0"
                                    FontSize="12" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ViewModel.DeveloperCredentialsError, Mode=OneWay}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.DeveloperCredentialsError), Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingRowDividerStyle}">
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sign-in browser" />
                                <TextBlock
                                    Text="Where Google sign-in and the Photos Picker open."
                                    Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="220"
                                ItemsSource="{x:Bind ViewModel.SignInBrowserChoices}"
                                DisplayMemberPath="Label"
                                SelectedIndex="{x:Bind ViewModel.SelectedSignInBrowserIndex, Mode=TwoWay}" />
                            <TextBox
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                PlaceholderText="C:\Program Files\Browser\browser.exe"
                                Text="{x:Bind ViewModel.CustomBrowserPath, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.IsCustomBrowserPathVisible, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingRowDividerStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{x:Bind ViewModel.SignInStatusText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <HyperlinkButton
                                        Content="Cancel"
                                        Command="{x:Bind ViewModel.SignInCancelCommand}"
                                        Visibility="{x:Bind ViewModel.IsWaitingForBrowser, Mode=OneWay}" />
                                    <Button
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="{x:Bind ViewModel.SignInButtonText, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SignInCommand}"
                                        Visibility="{x:Bind views:XamlFunctions.CollapsedWhenTrue(ViewModel.IsConnected), Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                            <InfoBar
                                Severity="Error"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.SignInError), Mode=OneWay}"
                                IsClosable="False"
                                Message="{x:Bind ViewModel.SignInError, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- First target -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid Padding="20,16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="24" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="First target" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="Where else your iPhone photos are backed up"
                                Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingRowDividerStyle}">
                        <RadioButtons
                            SelectedIndex="{x:Bind ViewModel.SelectedTargetIndex, Mode=TwoWay}"
                            MaxColumns="2">
                            <RadioButton>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE753;" FontSize="16" />
                                    <TextBlock Text="OneDrive" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE968;" FontSize="16" />
                                    <TextBlock Text="Synology Photos" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                    </Border>

                    <Border Style="{StaticResource SettingRowDividerStyle}">
                        <views:TargetFolderEditor Folder="{x:Bind ViewModel.SelectedFolder, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Border>

            <Button
                HorizontalAlignment="Right"
                Style="{StaticResource AccentButtonStyle}"
                Content="Finish setup"
                Command="{x:Bind ViewModel.FinishSetupCommand}"
                IsEnabled="{x:Bind ViewModel.CanFinishSetup, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
