<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PhotoRecull.App.Views.NewCleanupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoRecull.App.Views"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="New cleanup"
    PrimaryButtonText="Start"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind HasSelectedTarget, Mode=OneWay}">

    <StackPanel Width="472" Spacing="16">
        <TextBlock
            Text="Next, you select the photos you kept in Google Photos. PhotoRecull suggests a date range from your pick, and you can adjust it before scanning."
            TextWrapping="Wrap" />
        <StackPanel Spacing="4">
            <TextBlock Text="Repeat the cull on" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ItemsRepeater ItemsSource="{x:Bind TargetChoices}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="views:TargetChoice">
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock
                                        Text="{x:Bind Target.FolderPath}"
                                        Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </CheckBox>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
        <TextBlock
            Text="{x:Bind PickerStartHint}"
            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(PickerStartHint)}" />
    </StackPanel>
</ContentDialog>
