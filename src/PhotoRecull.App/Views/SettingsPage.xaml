<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhotoRecull.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoRecull.App.Views"
    xmlns:vm="using:PhotoRecull.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PageHorizontalPadding}" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleTextBlockStyle}" />

            <StackPanel Spacing="4">
                <TextBlock Text="Targets" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Text="Where else your iPhone photos are backed up. A new cleanup can scan every target that's on."
                    Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Targets}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:TargetSettingsRowViewModel">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Padding="20,16" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Folder.Glyph}" FontSize="24" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Folder.Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="2"
                                        MinWidth="0"
                                        OnContent="On"
                                        OffContent="Off"
                                        AutomationProperties.Name="{x:Bind Folder.Name}"
                                        IsOn="{x:Bind IsUsed, Mode=TwoWay}"
                                        IsEnabled="{x:Bind CanBeTurnedOff, Mode=OneWay}" />
                                </Grid>
                                <Border
                                    Style="{StaticResource SettingRowDividerStyle}"
                                    Visibility="{x:Bind IsUsed, Mode=OneWay}">
                                    <views:TargetFolderEditor Folder="{x:Bind Folder}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
