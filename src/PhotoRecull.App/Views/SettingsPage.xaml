<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhotoRecull.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoRecull.App.Views"
    xmlns:vm="using:PhotoRecull.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PageHorizontalPadding}" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleTextBlockStyle}" />

            <StackPanel Spacing="4">
                <TextBlock Text="Source" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Text="Where you pick the photos you kept."
                    Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid Padding="20,16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE91B;" FontSize="24" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Google Photos" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.GooglePhotos.StatusText, Mode=OneWay}"
                                Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button
                                Content="Sign out"
                                Command="{x:Bind ViewModel.GooglePhotos.SignOutCommand}"
                                Visibility="{x:Bind ViewModel.GooglePhotos.IsSignedIn, Mode=OneWay}" />
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Sign in"
                                Command="{x:Bind ViewModel.GooglePhotos.SignInCommand}"
                                Visibility="{x:Bind ViewModel.GooglePhotos.CanSignIn, Mode=OneWay}" />
                            <Button
                                Content="Cancel"
                                Command="{x:Bind ViewModel.GooglePhotos.SignInCancelCommand}"
                                Visibility="{x:Bind ViewModel.GooglePhotos.IsWaitingForBrowser, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SettingRowDividerStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sign-in browser" />
                                    <TextBlock
                                        Text="Where Google sign-in and the Photos Picker open."
                                        Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="220"
                                    AutomationProperties.Name="Sign-in browser"
                                    ItemsSource="{x:Bind ViewModel.GooglePhotos.SignInBrowserChoices}"
                                    DisplayMemberPath="Label"
                                    SelectedIndex="{x:Bind ViewModel.GooglePhotos.SelectedSignInBrowserIndex, Mode=TwoWay}" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    PlaceholderText="C:\Program Files\Browser\browser.exe"
                                    Text="{x:Bind ViewModel.GooglePhotos.CustomBrowserPath, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.GooglePhotos.IsCustomBrowserPathVisible, Mode=OneWay}" />
                            </Grid>
                            <InfoBar
                                Severity="Error"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.GooglePhotos.SignInError), Mode=OneWay}"
                                IsClosable="False"
                                Message="{x:Bind ViewModel.GooglePhotos.SignInError, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Spacing="4" Margin="0,16,0,0">
                <TextBlock Text="Targets" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Text="Where else your iPhone photos are backed up. A new cleanup can scan every target that's on."
                    Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Targets}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:TargetSettingsRowViewModel">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Padding="20,16" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Folder.Glyph}" FontSize="24" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Folder.Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="2"
                                        MinWidth="0"
                                        OnContent="On"
                                        OffContent="Off"
                                        AutomationProperties.Name="{x:Bind Folder.Name}"
                                        IsOn="{x:Bind IsUsed, Mode=TwoWay}"
                                        IsEnabled="{x:Bind CanBeTurnedOff, Mode=OneWay}" />
                                </Grid>
                                <Border
                                    Style="{StaticResource SettingRowDividerStyle}"
                                    Visibility="{x:Bind IsUsed, Mode=OneWay}">
                                    <views:TargetFolderEditor Folder="{x:Bind Folder}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
