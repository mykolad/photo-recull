<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhotoRecull.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoRecull.App.Views"
    xmlns:vm="using:PhotoRecull.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PageHorizontalPadding}" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="History" Style="{StaticResource PageTitleTextBlockStyle}" />
            <TextBlock
                Text="Every stage and delete, newest first. Removing an entry only forgets it; no files are touched."
                Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                TextWrapping="Wrap" />

            <TextBlock
               
                Text="No photos have been staged or deleted yet."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{x:Bind ViewModel.HasNoRuns}" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Runs}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryRunViewModel">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid Padding="16,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind TargetGlyph}" FontSize="22" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Border
                                            Padding="8,0"
                                            CornerRadius="10"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            Visibility="{x:Bind IsInterrupted}"
                                            ToolTipService.ToolTip="Stopped partway. Open its cleanup in Library to finish the rest.">
                                            <TextBlock Text="Interrupted" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind WhenText}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind WhereText}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Open folder" Command="{x:Bind OpenFolderCommand}" Visibility="{x:Bind CanOpenFolder}" />
                                    <Button
                                        Click="OnRemoveClick"
                                        IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind RemoveToolTip, Mode=OneWay}"
                                        AutomationProperties.Name="Remove from History">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
