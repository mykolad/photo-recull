<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhotoRecull.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoRecull.App.Views"
    xmlns:vm="using:PhotoRecull.App.ViewModels"
    xmlns:controls="using:PhotoRecull.App.Controls">

    <Page.Resources>
        <Style x:Key="LegendSwatchStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="LibraryCardTemplate" x:DataType="vm:LibraryCardViewModel">
            <Grid MinHeight="184">
                <Rectangle
                    RadiusX="8"
                    RadiusY="8"
                    Stroke="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                    StrokeThickness="1"
                    StrokeDashArray="4,3"
                    Visibility="{x:Bind IsNotCleanedGap}" />
                <Border
                    Style="{StaticResource CardBorderStyle}"
                    BorderBrush="{x:Bind views:XamlFunctions.CardBorderBrush(IsReadyToAct)}"
                    Visibility="{x:Bind views:XamlFunctions.CollapsedWhenTrue(IsNotCleanedGap)}" />
                <Grid Padding="16,14" RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind RangeLabel}" FontSize="16" FontWeight="SemiBold" LineHeight="22" />
                    <TextBlock Grid.Row="1" Text="{x:Bind DaysLabel}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    <Border
                        Grid.Row="2"
                        Margin="0,10,0,0"
                        Height="22"
                        Padding="8,0"
                        CornerRadius="11"
                        HorizontalAlignment="Left"
                        Background="{x:Bind views:XamlFunctions.PillBackground(Status)}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{x:Bind views:XamlFunctions.PillForeground(Status)}" />
                            <TextBlock Text="{x:Bind StatusText}" FontSize="12" Foreground="{x:Bind views:XamlFunctions.PillForeground(Status)}" />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Grid.Row="4"
                        Margin="0,12,0,0"
                        Text="{x:Bind PickedLine}"
                        Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                        Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(PickedLine)}" />
                    <TextBlock Grid.Row="5" Text="{x:Bind StateLine}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    <HyperlinkButton Grid.Row="6" Margin="-8,4,0,0" Padding="8,4" Command="{x:Bind ActionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ActionText}" FontSize="13" />
                            <FontIcon Glyph="&#xE76C;" FontSize="10" />
                        </StackPanel>
                    </HyperlinkButton>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="{StaticResource PageHorizontalPadding}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Library" Style="{StaticResource PageTitleTextBlockStyle}" />
            <Button
                Grid.Column="1"
                Content="{x:Bind ViewModel.ContinueText}"
                Command="{x:Bind ViewModel.ContinueCommand}"
                Visibility="{x:Bind ViewModel.IsContinueVisible}" />
            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NewCleanupCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New cleanup" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="40,0,40,32" Spacing="12">

                <Border Style="{StaticResource CardBorderStyle}" Padding="16,12,16,14">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Coverage" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.NotCleanedNote}"
                                Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <Button
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.ShowPreviousYearCommand}"
                                    ToolTipService.ToolTip="Previous year">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                </Button>
                                <TextBlock
                                    Text="{x:Bind ViewModel.CoverageYear, Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    VerticalAlignment="Center"
                                    Margin="4,0" />
                                <Button
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.ShowNextYearCommand}"
                                    ToolTipService.ToolTip="Next year">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <controls:CoverageStrip x:Name="Coverage" />

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Style="{StaticResource LegendSwatchStyle}" Fill="{ThemeResource CleanupDoneBrush}" />
                                <TextBlock Text="Done" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Style="{StaticResource LegendSwatchStyle}" Fill="{ThemeResource CleanupStagedBrush}" />
                                <TextBlock Text="Staged" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Style="{StaticResource LegendSwatchStyle}" Fill="{ThemeResource CleanupReadyToActBrush}" />
                                <TextBlock Text="Ready to act" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Style="{StaticResource LegendSwatchStyle}" Fill="{ThemeResource CleanupPickedBrush}" />
                                <TextBlock Text="Picked" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle
                                    Style="{StaticResource LegendSwatchStyle}"
                                    Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Stroke="{ThemeResource NotCleanedHatchBrush}" />
                                <TextBlock Text="Not cleaned" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="2" Height="12" Fill="{ThemeResource TodayLineBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Today" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Style="{StaticResource CardBorderStyle}"
                    Padding="24,20"
                    Visibility="{x:Bind ViewModel.HasNoCleanups}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="No cleanups yet" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="Start a cleanup: pick the photos you kept in Google Photos, and PhotoRecull finds the ones you deleted in your other copies."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}" ItemTemplate="{StaticResource LibraryCardTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="200"
                            MinItemHeight="184"
                            MinColumnSpacing="8"
                            MinRowSpacing="8"
                            MaximumRowsOrColumns="4"
                            ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
