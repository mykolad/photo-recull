<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhotoRecull.App.Views.CleanupFlowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoRecull.App.Views"
    xmlns:vm="using:PhotoRecull.App.ViewModels"
    xmlns:controls="using:PhotoRecull.App.Controls">

    <Page.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="StatNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="40,20,40,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <HyperlinkButton Padding="0" Command="{x:Bind ViewModel.BackToLibraryCommand}">
                        <TextBlock
                            Text="Library"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </HyperlinkButton>
                    <FontIcon
                        Glyph="&#xE76C;"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <FontIcon Glyph="&#xE91B;" FontSize="12" />
                    <TextBlock Text="Google Photos" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    <FontIcon Glyph="&#xE72A;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.TargetsLine}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    <TextBlock Text="·" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.RangeDaysLine, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <controls:FlowStepper x:Name="Stepper" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <Grid Padding="40,0,40,32">
                <!-- Pick -->
                <StackPanel MaxWidth="780" HorizontalAlignment="Left" Spacing="12" Visibility="{x:Bind ViewModel.IsPickStep, Mode=OneWay}">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20" Visibility="{x:Bind ViewModel.IsSavedPickVisible, Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SavedPickTitle}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.SavedPickDetail}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.SavedPickChoiceIndex, Mode=TwoWay}">
                                <RadioButton>
                                    <StackPanel>
                                        <TextBlock Text="Use saved pick" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.UseSavedPickDescription}"
                                            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton>
                                    <StackPanel>
                                        <TextBlock Text="Pick again" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.PickAgainDescription}"
                                            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </RadioButtons>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource AccentButtonStyle}" Content="Continue" Command="{x:Bind ViewModel.ContinueFromSavedPickCommand}" />
                                <Button Content="Back" Command="{x:Bind ViewModel.BackToLibraryCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="24" Visibility="{x:Bind ViewModel.IsWaitingForPickerVisible, Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <InfoBar
                                Severity="Informational"
                                IsClosable="False"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.ReauthenticatingMessage), Mode=OneWay}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.ReauthenticatingMessage), Mode=OneWay}"
                                Message="{x:Bind ViewModel.ReauthenticatingMessage, Mode=OneWay}" />
                            <InfoBar
                                Severity="Error"
                                IsClosable="False"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.PickError), Mode=OneWay}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.PickError), Mode=OneWay}"
                                Message="{x:Bind ViewModel.PickError, Mode=OneWay}">
                                <InfoBar.ActionButton>
                                    <Button Content="Open picker again" Command="{x:Bind ViewModel.PickAgainCommand}" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing Width="48" Height="48" VerticalAlignment="Top" IsActive="{x:Bind ViewModel.IsPicking, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.WaitingCaption}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.WaitingHeadline}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.WaitingHelp}"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelPickCommand}" />
                                <HyperlinkButton Content="Reopen browser" Command="{x:Bind ViewModel.ReopenBrowserCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Range -->
                <StackPanel MaxWidth="780" HorizontalAlignment="Left" Spacing="12" Visibility="{x:Bind ViewModel.IsRangeStep, Mode=OneWay}">
                    <InfoBar
                        Severity="Success"
                        IsOpen="True"
                        IsClosable="False"
                        Title="{x:Bind ViewModel.PickedSummaryTitle, Mode=OneWay}"
                        Message="{x:Bind ViewModel.PickedSummaryMessage, Mode=OneWay}" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Date range to clean up" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    Text="Photos on your targets in this range that aren't in your pick become candidates for removal. The suggestion comes from your pick. Adjust it if needed."
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <controls:RangeComparisonBars x:Name="ComparisonBars" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel>
                                    <TextBlock Text="From" Style="{StaticResource FieldLabelStyle}" />
                                    <CalendarDatePicker Width="180" Date="{x:Bind ViewModel.RangeFrom, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="To" Style="{StaticResource FieldLabelStyle}" />
                                    <CalendarDatePicker Width="180" Date="{x:Bind ViewModel.RangeTo, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Suggestions" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Suggestions}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RangeSuggestionChipViewModel">
                                            <Button
                                                Height="28"
                                                Padding="10,0"
                                                FontSize="13"
                                                Content="{x:Bind Text}"
                                                Command="{x:Bind ChooseCommand}"
                                                Background="{x:Bind views:XamlFunctions.ChipBackground(IsSelected), Mode=OneWay}"
                                                BorderBrush="{x:Bind views:XamlFunctions.ChipBorder(IsSelected), Mode=OneWay}"
                                                Foreground="{x:Bind views:XamlFunctions.ChipForeground(IsSelected), Mode=OneWay}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                            <InfoBar
                                Severity="Error"
                                IsClosable="False"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.RangeError), Mode=OneWay}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.RangeError), Mode=OneWay}"
                                Message="{x:Bind ViewModel.RangeError, Mode=OneWay}" />
                            <InfoBar
                                Severity="Warning"
                                IsClosable="False"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.DaysOutsidePickWarning), Mode=OneWay}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.DaysOutsidePickWarning), Mode=OneWay}"
                                Message="{x:Bind ViewModel.DaysOutsidePickWarning, Mode=OneWay}" />
                            <InfoBar
                                Severity="Warning"
                                IsClosable="False"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.OverlapWarning), Mode=OneWay}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.OverlapWarning), Mode=OneWay}"
                                Message="{x:Bind ViewModel.OverlapWarning, Mode=OneWay}" />
                            <InfoBar
                                Severity="Informational"
                                IsClosable="False"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.PickedPhotosLeftOutNote), Mode=OneWay}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.PickedPhotosLeftOutNote), Mode=OneWay}"
                                Message="{x:Bind ViewModel.PickedPhotosLeftOutNote, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Scan targets"
                            Command="{x:Bind ViewModel.ScanTargetsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRangeValid, Mode=OneWay}" />
                        <HyperlinkButton Content="Pick again" Command="{x:Bind ViewModel.PickAgainCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Scan -->
                <StackPanel MaxWidth="780" HorizontalAlignment="Left" Spacing="12" Visibility="{x:Bind ViewModel.IsScanStep, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ScanTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="Reading capture times from file names and EXIF, then matching one-to-one to your pick (±2 s)."
                            Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    </StackPanel>
                    <InfoBar
                        Severity="Error"
                        IsClosable="False"
                        IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.ScanError), Mode=OneWay}"
                        Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.ScanError), Mode=OneWay}"
                        Message="{x:Bind ViewModel.ScanError, Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ScanRows}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:TargetScanRowViewModel">
                                <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    Text="{x:Bind FolderPath}"
                                                    Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind StatusText, Mode=OneWay}"
                                                VerticalAlignment="Center"
                                                Foreground="{x:Bind views:XamlFunctions.DoneOrPrimaryBrush(IsDone), Mode=OneWay}" />
                                        </Grid>
                                        <ProgressBar
                                            Height="3"
                                            Maximum="100"
                                            Value="{x:Bind Percent, Mode=OneWay}"
                                            Foreground="{x:Bind views:XamlFunctions.DoneOrAccentBrush(IsDone), Mode=OneWay}" />
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind PhotoFilesFoundText, Mode=OneWay}" Style="{StaticResource StatNumberStyle}" />
                                                <TextBlock Text="Photo files found" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind IphonePhotosInRangeText, Mode=OneWay}" Style="{StaticResource StatNumberStyle}" />
                                                <TextBlock Text="iPhone photos in range" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{x:Bind SkippedText, Mode=OneWay}" Style="{StaticResource StatNumberStyle}" />
                                                <TextBlock Text="Skipped" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock
                                            Text="{x:Bind CurrentActivityText, Mode=OneWay}"
                                            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Review results"
                            Command="{x:Bind ViewModel.ReviewResultsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsScanComplete, Mode=OneWay}" />
                        <Button
                            Content="Cancel"
                            Command="{x:Bind ViewModel.CancelScanCommand}"
                            Visibility="{x:Bind views:XamlFunctions.CollapsedWhenTrue(ViewModel.IsScanComplete), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
