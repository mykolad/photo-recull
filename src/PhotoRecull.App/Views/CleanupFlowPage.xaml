<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhotoRecull.App.Views.CleanupFlowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoRecull.App.Views"
    xmlns:vm="using:PhotoRecull.App.ViewModels"
    xmlns:controls="using:PhotoRecull.App.Controls">

    <Page.Resources>
        <Style x:Key="StatNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="40,20,40,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <HyperlinkButton Padding="0" Command="{x:Bind ViewModel.BackToLibraryCommand}">
                        <TextBlock
                            Text="Library"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </HyperlinkButton>
                    <FontIcon
                        Glyph="&#xE76C;"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    <HyperlinkButton
                        Margin="8,4,0,0"
                        VerticalAlignment="Center"
                        Click="OnDiscardClick"
                        Visibility="{x:Bind ViewModel.CanDiscard, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        ToolTipService.ToolTip="Forget this cleanup. No files are moved or deleted.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                            <TextBlock Text="Discard" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <FontIcon Glyph="&#xE91B;" FontSize="12" />
                    <TextBlock Text="Google Photos" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    <FontIcon Glyph="&#xE72A;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.TargetsLine}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    <TextBlock Text="·" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.RangeDaysLine, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <controls:FlowStepper x:Name="Stepper" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Visibility="{x:Bind views:XamlFunctions.CollapsedWhenTrue(ViewModel.IsReviewStep), Mode=OneWay}">
            <Grid Padding="40,0,40,32">
                <!-- Pick -->
                <StackPanel MaxWidth="780" HorizontalAlignment="Left" Spacing="12" Visibility="{x:Bind ViewModel.IsPickStep, Mode=OneWay}">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20" Visibility="{x:Bind ViewModel.IsSavedPickVisible, Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SavedPickTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.SavedPickDetail, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.SavedPickChoiceIndex, Mode=TwoWay}">
                                <RadioButton>
                                    <StackPanel>
                                        <TextBlock Text="Use saved pick" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.UseSavedPickDescription}"
                                            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton>
                                    <StackPanel>
                                        <TextBlock Text="Pick again" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.PickAgainDescription}"
                                            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </RadioButtons>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource AccentButtonStyle}" Content="Continue" Command="{x:Bind ViewModel.ContinueFromSavedPickCommand}" />
                                <Button Content="Back" Command="{x:Bind ViewModel.BackToLibraryCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="24" Visibility="{x:Bind ViewModel.IsWaitingForPickerVisible, Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <InfoBar
                                Severity="Informational"
                                IsClosable="False"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.ReauthenticatingMessage), Mode=OneWay}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.ReauthenticatingMessage), Mode=OneWay}"
                                Message="{x:Bind ViewModel.ReauthenticatingMessage, Mode=OneWay}" />
                            <InfoBar
                                Severity="Error"
                                IsClosable="False"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.PickError), Mode=OneWay}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.PickError), Mode=OneWay}"
                                Message="{x:Bind ViewModel.PickError, Mode=OneWay}">
                                <InfoBar.ActionButton>
                                    <Button Content="Open picker again" Command="{x:Bind ViewModel.PickAgainCommand}" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing Width="48" Height="48" VerticalAlignment="Top" IsActive="{x:Bind ViewModel.IsPicking, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.WaitingCaption}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.WaitingHeadline, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.WaitingHelp, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelPickCommand}" />
                                <HyperlinkButton Content="Reopen browser" Command="{x:Bind ViewModel.ReopenBrowserCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Range -->
                <StackPanel MaxWidth="780" HorizontalAlignment="Left" Spacing="12" Visibility="{x:Bind ViewModel.IsRangeStep, Mode=OneWay}">
                    <InfoBar
                        Severity="Success"
                        IsOpen="True"
                        IsClosable="False"
                        Title="{x:Bind ViewModel.PickedSummaryTitle, Mode=OneWay}"
                        Message="{x:Bind ViewModel.PickedSummaryMessage, Mode=OneWay}" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Date range to clean up" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    Text="Photos on your targets in this range that aren't in your pick become candidates for removal. The suggestion comes from your pick. Adjust it if needed."
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <controls:RangeComparisonBars x:Name="ComparisonBars" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <CalendarDatePicker Header="From" Width="180" Date="{x:Bind ViewModel.RangeFrom, Mode=TwoWay}" />
                                <CalendarDatePicker Header="To" Width="180" Date="{x:Bind ViewModel.RangeTo, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Suggestions" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Suggestions}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RangeSuggestionChipViewModel">
                                            <Button
                                                Height="28"
                                                Padding="10,0"
                                                FontSize="13"
                                                Content="{x:Bind Text}"
                                                Command="{x:Bind ChooseCommand}"
                                                Background="{x:Bind views:XamlFunctions.ChipBackground(IsSelected), Mode=OneWay}"
                                                BorderBrush="{x:Bind views:XamlFunctions.ChipBorder(IsSelected), Mode=OneWay}"
                                                Foreground="{x:Bind views:XamlFunctions.ChipForeground(IsSelected), Mode=OneWay}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                            <InfoBar
                                Severity="Error"
                                IsClosable="False"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.RangeError), Mode=OneWay}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.RangeError), Mode=OneWay}"
                                Message="{x:Bind ViewModel.RangeError, Mode=OneWay}" />
                            <InfoBar
                                Severity="Warning"
                                IsClosable="False"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.DaysOutsidePickWarning), Mode=OneWay}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.DaysOutsidePickWarning), Mode=OneWay}"
                                Message="{x:Bind ViewModel.DaysOutsidePickWarning, Mode=OneWay}" />
                            <InfoBar
                                Severity="Warning"
                                IsClosable="False"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.OverlapWarning), Mode=OneWay}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.OverlapWarning), Mode=OneWay}"
                                Message="{x:Bind ViewModel.OverlapWarning, Mode=OneWay}" />
                            <InfoBar
                                Severity="Informational"
                                IsClosable="False"
                                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.PickedPhotosLeftOutNote), Mode=OneWay}"
                                Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.PickedPhotosLeftOutNote), Mode=OneWay}"
                                Message="{x:Bind ViewModel.PickedPhotosLeftOutNote, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Scan targets"
                            Command="{x:Bind ViewModel.ScanTargetsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRangeValid, Mode=OneWay}" />
                        <HyperlinkButton Content="Pick again" Command="{x:Bind ViewModel.PickAgainCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Scan -->
                <StackPanel MaxWidth="780" HorizontalAlignment="Left" Spacing="12" Visibility="{x:Bind ViewModel.IsScanStep, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ScanTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="Reading capture times from file names and EXIF, then matching one-to-one to your pick (±2 s)."
                            Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    </StackPanel>
                    <InfoBar
                        Severity="Error"
                        IsClosable="False"
                        IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.ScanError), Mode=OneWay}"
                        Visibility="{x:Bind views:XamlFunctions.VisibleWhenNotEmpty(ViewModel.ScanError), Mode=OneWay}"
                        Message="{x:Bind ViewModel.ScanError, Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ScanRows}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:TargetScanRowViewModel">
                                <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    Text="{x:Bind FolderPath}"
                                                    Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind StatusText, Mode=OneWay}"
                                                VerticalAlignment="Center"
                                                Foreground="{x:Bind views:XamlFunctions.DoneOrPrimaryBrush(IsDone), Mode=OneWay}" />
                                        </Grid>
                                        <ProgressBar
                                            Height="3"
                                            Maximum="100"
                                            Value="{x:Bind Percent, Mode=OneWay}"
                                            Foreground="{x:Bind views:XamlFunctions.DoneOrAccentBrush(IsDone), Mode=OneWay}" />
                                        <Grid ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind PhotoFilesFoundText, Mode=OneWay}" Style="{StaticResource StatNumberStyle}" />
                                                <TextBlock Text="Photo files found" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind IphonePhotosInRangeText, Mode=OneWay}" Style="{StaticResource StatNumberStyle}" />
                                                <TextBlock Text="iPhone photos in range" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{x:Bind SkippedText, Mode=OneWay}" Style="{StaticResource StatNumberStyle}" />
                                                <TextBlock Text="Skipped" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock
                                            Text="{x:Bind CurrentActivityText, Mode=OneWay}"
                                            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Review results"
                            Command="{x:Bind ViewModel.ReviewResultsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsScanComplete, Mode=OneWay}" />
                        <Button
                            Content="Cancel"
                            Command="{x:Bind ViewModel.CancelScanCommand}"
                            Visibility="{x:Bind views:XamlFunctions.CollapsedWhenTrue(ViewModel.IsScanComplete), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <!-- Result -->
                <StackPanel MaxWidth="780" HorizontalAlignment="Left" Spacing="12" Visibility="{x:Bind ViewModel.IsResultStep, Mode=OneWay}">
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="{x:Bind views:XamlFunctions.ResultSeverity(ViewModel.ResultHasFailures), Mode=OneWay}"
                        Title="{x:Bind ViewModel.ResultTitle, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ResultTargets}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResultTargetRow">
                                <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                                    <Grid ColumnSpacing="16" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind Location}"
                                                Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Location}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            Content="{x:Bind OpenButtonText}"
                                            Command="{x:Bind OpenCommand}"
                                            Visibility="{x:Bind HasOpenButton}" />
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="32" Margin="36,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind SucceededCount}" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind SucceededLabel}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock
                                                    Text="{x:Bind FailedCount}"
                                                    FontSize="20"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind views:XamlFunctions.FailureCountBrush(FailedCount)}" />
                                                <TextBlock Text="Failed" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ResultHasFailures, Mode=OneWay}">
                        <TextBlock Text="Failures" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,8">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.ResultFailures}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResultFailureRow">
                                        <Grid ColumnSpacing="12" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind TargetName}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Reason}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Border>
                        <Button Content="Retry failed" Command="{x:Bind ViewModel.RetryFailedCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" Content="Back to Library" Command="{x:Bind ViewModel.BackToLibraryCommand}" />
                        <Button Content="View history" Command="{x:Bind ViewModel.ViewHistoryCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Review (disabled while the preview is open, so Tab stays in the preview) -->
        <ContentControl
            Grid.Row="1"
            IsTabStop="False"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsReviewStep, Mode=OneWay}"
            IsEnabled="{x:Bind views:XamlFunctions.Not(ViewModel.Review.IsPreviewOpen), Mode=OneWay}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Padding="40,0,40,8" Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="ReviewTabs" SelectionChanged="OnReviewTabChanged">
                        <SelectorBarItem
                            x:Name="TimelineTab"
                            IsSelected="True"
                            Text="{x:Bind views:XamlFunctions.TabText('Timeline', ViewModel.Review.TimelineCount), Mode=OneWay}" />
                        <SelectorBarItem Text="{x:Bind views:XamlFunctions.TabText('Skipped', ViewModel.Review.SkippedCount), Mode=OneWay}" />
                    </SelectorBar>
                    <ComboBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Show"
                        Visibility="{x:Bind ViewModel.Review.IsTimelineTab, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.Review.FilterIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="All photos" />
                        <ComboBoxItem Content="Hide photos to remove" />
                        <ComboBoxItem Content="Only photos to remove" />
                    </ComboBox>
                    <ComboBox
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Time zone"
                        SelectedIndex="{x:Bind ViewModel.Review.TimeModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Bind ViewModel.Review.LocalTimeLabel, Mode=OneWay}" />
                        <ComboBoxItem Content="UTC" />
                    </ComboBox>
                    <Button Grid.Column="3" VerticalAlignment="Center" Command="{x:Bind ViewModel.Review.ExportCandidatesCommand, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock Text="Export list (CSV)" />
                        </StackPanel>
                    </Button>
                    <HyperlinkButton Grid.Column="4" VerticalAlignment="Center" Command="{x:Bind ViewModel.PickAgainCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Pick again" />
                        </StackPanel>
                    </HyperlinkButton>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.Review.TabExplanation, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Margin="40,24"
                Text="{x:Bind ViewModel.Review.NothingShownText, Mode=OneWay}"
                Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                Visibility="{x:Bind ViewModel.Review.HasNothingShown, Mode=OneWay}" />
            <ScrollViewer Grid.Row="1">
                <ItemsRepeater Margin="40,0,40,24" ItemsSource="{x:Bind ViewModel.Review.Days, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="20" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReviewDayViewModel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Header, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <ItemsRepeater ItemsSource="{x:Bind Segments}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReviewSegmentViewModel">
                                            <Border
                                                CornerRadius="8"
                                                Padding="{x:Bind views:XamlFunctions.BurstPadding(IsExpandedBurst)}"
                                                Background="{x:Bind views:XamlFunctions.BurstBackground(IsExpandedBurst)}">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnSpacing="6" Visibility="{x:Bind IsExpandedBurst}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" VerticalAlignment="Center" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="12"
                                                            VerticalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis"
                                                            Text="{x:Bind ExpandedBurst.Header, Mode=OneWay}" />
                                                        <Button
                                                            Grid.Column="2"
                                                            Height="26"
                                                            Padding="8,0"
                                                            FontSize="12"
                                                            Command="{x:Bind ExpandedBurst.ToggleExpandedCommand}"
                                                            AutomationProperties.Name="Stack the burst again">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE70E;" FontSize="10" />
                                                                <TextBlock Text="Stack" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                    <ItemsRepeater ItemsSource="{x:Bind Cells}">
                                                        <ItemsRepeater.Layout>
                                                            <UniformGridLayout
                                                                MinItemWidth="150"
                                                                MinColumnSpacing="8"
                                                                MinRowSpacing="12"
                                                                MaximumRowsOrColumns="6"
                                                                ItemsStretch="Fill" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ReviewStackViewModel">
                                                                <StackPanel Spacing="4">
                                                                    <Button
                                                                        Padding="0"
                                                                        BorderThickness="0"
                                                                        CornerRadius="4"
                                                                        Background="Transparent"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Command="{x:Bind ActivateCommand}"
                                                                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                                                        <Grid Height="112">
                                                                            <Grid
                                                                                Margin="8,0,0,8"
                                                                                CornerRadius="4"
                                                                                Background="Black"
                                                                                BorderBrush="{x:Bind views:XamlFunctions.StackBackCardBorder(FrameBehindCover.IsMarkedToRemove), Mode=OneWay}"
                                                                                BorderThickness="{x:Bind views:XamlFunctions.ToRemoveOutline(FrameBehindCover.IsMarkedToRemove), Mode=OneWay}"
                                                                                Visibility="{x:Bind IsBurst}">
                                                                                <Image Source="{x:Bind FrameBehindCover.Thumbnail, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.55" />
                                                                            </Grid>
                                                                            <Grid
                                                                                Margin="{x:Bind views:XamlFunctions.StackCoverMargin(IsBurst)}"
                                                                                CornerRadius="4"
                                                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                                                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                                                                BorderThickness="{x:Bind views:XamlFunctions.ToRemoveOutline(Cover.IsMarkedToRemove), Mode=OneWay}">
                                                                                <Image Source="{x:Bind Cover.Thumbnail, Mode=OneWay}" Stretch="UniformToFill" Opacity="{x:Bind Cover.ThumbnailOpacity, Mode=OneWay}" />
                                                                                <Border
                                                                                    Margin="6"
                                                                                    Padding="8,1"
                                                                                    CornerRadius="9"
                                                                                    HorizontalAlignment="Left"
                                                                                    VerticalAlignment="Top"
                                                                                    Background="{ThemeResource PillDoneBackground}"
                                                                                    Visibility="{x:Bind Cover.IsKept, Mode=OneWay}">
                                                                                    <TextBlock Text="Kept" FontSize="11" Foreground="{ThemeResource PillDoneForeground}" />
                                                                                </Border>
                                                                                <Border
                                                                                    Margin="6"
                                                                                    Width="22"
                                                                                    Height="22"
                                                                                    CornerRadius="11"
                                                                                    HorizontalAlignment="Right"
                                                                                    VerticalAlignment="Top"
                                                                                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                                                                                    ToolTipService.ToolTip="To remove"
                                                                                    Visibility="{x:Bind Cover.IsMarkedToRemove, Mode=OneWay}">
                                                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="White" />
                                                                                </Border>
                                                                                <Border
                                                                                    Margin="6"
                                                                                    MinWidth="22"
                                                                                    Height="22"
                                                                                    Padding="4,0"
                                                                                    CornerRadius="4"
                                                                                    HorizontalAlignment="Left"
                                                                                    VerticalAlignment="Bottom"
                                                                                    Background="White"
                                                                                    ToolTipService.ToolTip="{x:Bind Cover.CopyMarksText, Mode=OneWay}">
                                                                                    <FontIcon Glyph="{x:Bind Cover.TargetGlyphs, Mode=OneWay}" FontSize="13" Foreground="Black" />
                                                                                </Border>
                                                                                <Border
                                                                                    Margin="6"
                                                                                    Padding="6,1"
                                                                                    CornerRadius="4"
                                                                                    HorizontalAlignment="Right"
                                                                                    VerticalAlignment="Bottom"
                                                                                    Background="#99000000"
                                                                                    Visibility="{x:Bind ShowsVideoBadge, Mode=OneWay}">
                                                                                    <TextBlock Text="Video" FontSize="11" Foreground="White" />
                                                                                </Border>
                                                                                <Border
                                                                                    Margin="6"
                                                                                    Padding="6,2"
                                                                                    CornerRadius="4"
                                                                                    HorizontalAlignment="Right"
                                                                                    VerticalAlignment="Bottom"
                                                                                    Background="#99000000"
                                                                                    Visibility="{x:Bind ShowsFrameCount, Mode=OneWay}">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="White" />
                                                                                        <TextBlock Text="{x:Bind FrameCountText}" FontSize="11" Foreground="White" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                                <!-- A burst with frames that stay and frames that go shows both counts, so the cover that stays doesn't read as the whole burst. -->
                                                                                <Border
                                                                                    Margin="6"
                                                                                    CornerRadius="4"
                                                                                    HorizontalAlignment="Right"
                                                                                    VerticalAlignment="Bottom"
                                                                                    Visibility="{x:Bind IsMixedBurst, Mode=OneWay}">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="3" Padding="6,2" Background="#99000000" ToolTipService.ToolTip="Stay">
                                                                                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" />
                                                                                            <TextBlock Text="{x:Bind StayingCountText, Mode=OneWay}" FontSize="11" Foreground="White" />
                                                                                        </StackPanel>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="3" Padding="6,2" Background="{ThemeResource SystemFillColorCriticalBrush}" ToolTipService.ToolTip="To remove">
                                                                                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="White" />
                                                                                            <TextBlock Text="{x:Bind ToRemoveCountText, Mode=OneWay}" FontSize="11" Foreground="White" />
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Button>
                                                                    <TextBlock
                                                                        Text="{x:Bind Title}"
                                                                        FontSize="12"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTipService.ToolTip="{x:Bind Cover.FullPath, Mode=OneWay}" />
                                                                    <Grid ColumnSpacing="4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            Text="{x:Bind Subtitle, Mode=OneWay}"
                                                                            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                                                            TextWrapping="NoWrap"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            VerticalAlignment="Center" />
                                                                        <Button
                                                                            Grid.Column="1"
                                                                            Width="26"
                                                                            Height="26"
                                                                            Padding="0"
                                                                            Command="{x:Bind Cover.OpenOriginalCommand, Mode=OneWay}"
                                                                            Visibility="{x:Bind views:XamlFunctions.CollapsedWhenTrue(IsBurst)}"
                                                                            ToolTipService.ToolTip="Open original"
                                                                            AutomationProperties.Name="Open original">
                                                                            <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                                                        </Button>
                                                                        <Button
                                                                            Grid.Column="2"
                                                                            Height="26"
                                                                            Padding="8,0"
                                                                            FontSize="12"
                                                                            Content="{x:Bind Cover.KeepButtonText, Mode=OneWay}"
                                                                            Command="{x:Bind Cover.ToggleKeepCommand, Mode=OneWay}"
                                                                            Visibility="{x:Bind views:XamlFunctions.ShowsKeepButton(IsBurst, Cover.CanBeKept), Mode=OneWay}"
                                                                            Background="{x:Bind views:XamlFunctions.KeepButtonBackground(Cover.IsKept), Mode=OneWay}"
                                                                            Foreground="{x:Bind views:XamlFunctions.KeepButtonForeground(Cover.IsKept), Mode=OneWay}" />
                                                                        <Button
                                                                            Grid.Column="2"
                                                                            Width="26"
                                                                            Height="26"
                                                                            Padding="0"
                                                                            Command="{x:Bind ToggleExpandedCommand}"
                                                                            Visibility="{x:Bind IsBurst}"
                                                                            ToolTipService.ToolTip="Show frames"
                                                                            AutomationProperties.Name="Show frames">
                                                                            <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                                                        </Button>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <Border
                Grid.Row="2"
                Padding="40,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Review.ActionSummaryTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Review.ActionSummaryDetail, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        <ProgressBar IsIndeterminate="True" Margin="0,6,0,0" Visibility="{x:Bind ViewModel.IsActing, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Content="Mark as done"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.MarkAsDoneCommand}"
                        Visibility="{x:Bind ViewModel.Review.HasNothingToActOn, Mode=OneWay}" />
                    <Button
                        Grid.Column="1"
                        Click="OnDeleteClick"
                        Visibility="{x:Bind ViewModel.Review.HasCandidatesToActOn, Mode=OneWay}"
                        IsEnabled="{x:Bind views:XamlFunctions.CanAct(ViewModel.Review.HasCandidatesToActOn, ViewModel.IsActing), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock Text="Delete…" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnStageClick"
                        Visibility="{x:Bind ViewModel.Review.HasCandidatesToActOn, Mode=OneWay}"
                        IsEnabled="{x:Bind views:XamlFunctions.CanAct(ViewModel.Review.HasCandidatesToActOn, ViewModel.IsActing), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock Text="Stage candidates…" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        </ContentControl>

        <!-- Large preview. Collapsed until there's a review: before the Review step the
             binding has no source, and the panel would cover the step, with no way to close it. -->
        <Grid
            x:Name="PreviewOverlay"
            TabFocusNavigation="Cycle"
            Grid.RowSpan="2"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Visibility="{x:Bind ViewModel.Review.IsPreviewOpen, Mode=OneWay, FallbackValue=Collapsed}">
            <Border
                Margin="40,24"
                CornerRadius="8"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <Grid Background="Black" CornerRadius="8,0,0,8">
                        <Image Source="{x:Bind ViewModel.Review.PreviewImage, Mode=OneWay}" Stretch="Uniform" />
                        <Button
                            Margin="12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.Review.ShowPreviousPreviewCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Previous (←)"
                            AutomationProperties.Name="Previous photo">
                            <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        </Button>
                        <Button
                            Margin="12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.Review.ShowNextPreviewCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Next (→)"
                            AutomationProperties.Name="Next photo">
                            <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Grid Grid.Column="1" Padding="20" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock
                                    Text="{x:Bind ViewModel.Review.PreviewStatusText, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{x:Bind views:XamlFunctions.PreviewStatusBrush(ViewModel.Review.IsPreviewMarkedToRemove), Mode=OneWay}" />
                                <Button
                                    x:Name="ClosePreviewButton"
                                    HorizontalAlignment="Right"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.Review.ClosePreviewCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="Close (Esc)"
                                    AutomationProperties.Name="Close preview">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>
                            <TextBlock
                                Text="{x:Bind ViewModel.Review.PreviewTile.FileName, Mode=OneWay}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Review.PreviewPositionText, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="10">
                            <StackPanel>
                                <TextBlock Text="Local" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Review.PreviewTile.LocalTimeText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="UTC" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Review.PreviewTile.UtcTimeText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Time from" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Review.PreviewTile.TimeSourceLabel, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Type · size" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Review.PreviewTile.TypeAndSizeText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Burst" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Review.PreviewTile.BurstPositionText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Files" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Review.PreviewTile.CopiesText, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="8">
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.Review.ToggleKeepInPreviewCommand, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Review.PreviewTile.CanBeKept, Mode=OneWay}"
                                Content="{x:Bind views:XamlFunctions.PreviewKeepText(ViewModel.Review.PreviewTile.IsKept), Mode=OneWay}" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Content="Open original (O)"
                                Command="{x:Bind ViewModel.Review.OpenOriginalInPreviewCommand, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

