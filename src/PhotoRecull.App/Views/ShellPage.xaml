<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhotoRecull.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoRecull.App.Views">

    <NavigationView
        x:Name="Navigation"
        PaneDisplayMode="Left"
        OpenPaneLength="280"
        CompactPaneLength="56"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        SelectionChanged="OnNavigationSelectionChanged"
        PaneOpening="OnPaneOpening"
        PaneClosing="OnPaneClosing">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="LibraryItem" Content="Library" Tag="Library">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE787;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="History" Tag="History">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <StackPanel x:Name="ConnectedPanel" Padding="16,8,16,12" Spacing="10">
                <TextBlock Text="Connected" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ItemsRepeater x:Name="ConnectedServicesList">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="views:ConnectedServiceRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" />
                                    <TextBlock
                                        Text="{x:Bind Detail}"
                                        Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Detail}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <HyperlinkButton Content="Manage targets" Padding="0" Click="OnManageTargetsClick" />
            </StackPanel>
        </NavigationView.PaneFooter>

        <Grid>
            <Frame x:Name="ContentFrame" />
            <InfoBar
                x:Name="Toast"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="24"
                MaxWidth="420"
                Severity="Success"
                IsOpen="False" />
        </Grid>
    </NavigationView>
</Page>
