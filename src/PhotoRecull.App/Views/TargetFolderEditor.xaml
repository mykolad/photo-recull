<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhotoRecull.App.Views.TargetFolderEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoRecull.App.Views">

    <StackPanel Spacing="6">
        <TextBlock Text="Folder" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Text="{x:Bind Folder.FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{x:Bind Folder.PlaceholderText, Mode=OneWay}"
                AutomationProperties.Name="Folder" />
            <Button Grid.Column="1" Content="Browse…" Command="{x:Bind Folder.BrowseFolderCommand, Mode=OneWay}" />
        </Grid>
        <TextBlock
            Text="{x:Bind Folder.FolderHint, Mode=OneWay}"
            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
            TextWrapping="Wrap" />
        <TextBlock
            Text="{x:Bind Folder.FolderValidationText, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap"
            Foreground="{x:Bind views:XamlFunctions.ValidationResultBrush(Folder.IsFolderValid, Folder.IsCheckingFolder), Mode=OneWay}" />
        <TextBlock Text="Name" Margin="0,8,0,0" />
        <TextBox
            Text="{x:Bind Folder.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PlaceholderText="OneDrive, NAS, Dropbox…"
            AutomationProperties.Name="Name" />
        <TextBlock
            Text="What PhotoRecull calls this folder. Suggested from the folder until you type one."
            Style="{StaticResource SecondaryCaptionTextBlockStyle}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
