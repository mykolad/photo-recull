<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhotoRecull.App.Views.StagedReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhotoRecull.App.Views"
    xmlns:vm="using:PhotoRecull.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="40,24,40,12" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <HyperlinkButton Padding="0" Click="OnBackToLibraryClick" IsEnabled="{x:Bind views:XamlFunctions.Not(ViewModel.IsActing), Mode=OneWay}">
                    <TextBlock Text="Library" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </HyperlinkButton>
                <FontIcon Glyph="&#xE76C;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>
            <TextBlock Text="Staged photos" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" ToolTipService.ToolTip="Checking the stage folders" />
            <TextBlock
                Text="These photos were moved out of your targets for a last look. Move back any you want to keep, then delete the rest."
                Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                TextWrapping="Wrap" />
            <InfoBar
                Margin="0,8,0,0"
                IsClosable="True"
                Severity="{x:Bind views:XamlFunctions.ResultSeverity(ViewModel.ResultHasFailures), Mode=OneWay}"
                Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.ResultMessage), Mode=OneWay}" />
            <InfoBar
                Margin="0,8,0,0"
                IsClosable="False"
                Severity="Warning"
                Message="{x:Bind ViewModel.UnreachableMessage, Mode=OneWay}"
                IsOpen="{x:Bind views:XamlFunctions.IsNotEmpty(ViewModel.UnreachableMessage), Mode=OneWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="40,0,40,16">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Photos}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="200" MinItemHeight="236" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:StagedTileViewModel">
                        <StackPanel Spacing="4">
                            <Button
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{x:Bind OpenOriginalCommand}"
                                ToolTipService.ToolTip="Open the photo"
                                AutomationProperties.Name="{x:Bind FileName}">
                                <Grid Height="140" CornerRadius="4" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                    <Border
                                        Margin="6"
                                        MinWidth="22"
                                        Height="22"
                                        Padding="4,0"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Background="White">
                                        <FontIcon Glyph="{x:Bind TargetGlyph}" FontSize="13" Foreground="Black" />
                                    </Border>
                                </Grid>
                            </Button>
                            <TextBlock Text="{x:Bind FileName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind OriginalFolder}"
                                Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Photo.OriginalPath}" />
                            <Grid>
                                <TextBlock Text="{x:Bind Details}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" VerticalAlignment="Center" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Height="26"
                                    Padding="8,0"
                                    FontSize="12"
                                    Content="Move back"
                                    Command="{x:Bind MoveBackCommand}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <Grid
            Grid.Row="2"
            Padding="40,12"
            ColumnSpacing="12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ProgressBar IsIndeterminate="True" Margin="0,6,0,0" Visibility="{x:Bind ViewModel.IsActing, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Content="Move all back"
                Command="{x:Bind ViewModel.MoveAllBackCommand}"
                Visibility="{x:Bind ViewModel.HasPhotos, Mode=OneWay}" />
            <Button
                Grid.Column="2"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnDeleteAllClick"
                Visibility="{x:Bind ViewModel.HasPhotos, Mode=OneWay}"
                IsEnabled="{x:Bind views:XamlFunctions.Not(ViewModel.IsActing), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="Delete all…" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
