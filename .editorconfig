root = true

# The repository's C# style: what the code already follows. The build enforces every rule marked warning
# (EnforceCodeStyleInBuild, and warnings are errors); CI's `dotnet format style --verify-no-changes` catches those the
# build doesn't report.
[*.cs]
indent_style = space
indent_size = 4

# File-scoped namespaces, usings outside them, System first.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_sort_system_directives_first = true

# No `this.`.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_diagnostic.IDE0003.severity = warning
dotnet_diagnostic.IDE0009.severity = warning

# Unused usings and unread private members go.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning

# Private fields _camelCase; constants and static readonly fields PascalCase.
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_readonly_fields_are_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_fields_are_pascal_case.severity = warning
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_diagnostic.IDE1006.severity = warning

# The recommended analyzers (AnalysisLevel in Directory.Build.props) are on, but for these, which don't fit the code.
# The XML documentation file is built only for IDE0005: a summary is written where it says something, not for every
# member.
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CS1573.severity = none
# A review timeline's stack is a stack of photos (a burst), not a Stack<T>.
dotnet_diagnostic.CA1711.severity = none
# Parameters and results are the read-only interfaces, not the concrete collection behind them.
dotnet_diagnostic.CA1859.severity = none

[src/PhotoRecull.App/**.cs]
# x:Bind and [RelayCommand] bind to the view models' instance members, so they stay instance members like their
# neighbours.
dotnet_diagnostic.CA1822.severity = none
# The view models' and pages' CancellationTokenSources have no timer, so there's nothing to dispose: each is cancelled
# when it's replaced or its page is left.
dotnet_diagnostic.CA1001.severity = none

[tests/**.cs]
# Test names read as sentences: Subject_Scenario_Outcome.
dotnet_diagnostic.CA1707.severity = none
# xUnit makes a test class for each test; Dispose cleans up its temporary folder, there's no finalizer.
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.CA1001.severity = none
# Arrays written into an assertion read as the expected values; a test runs once.
dotnet_diagnostic.CA1861.severity = none
