<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.73.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
  </ItemGroup>

  <!-- Prevent the test project subfolder from being compiled into the main app -->
  <ItemGroup>
    <Compile Remove="PhotoCleanup.Tests\**" />
    <None Remove="PhotoCleanup.Tests\**" />
    <EmbeddedResource Remove="PhotoCleanup.Tests\**" />
  </ItemGroup>

</Project>
